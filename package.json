{
  "name": "@perdieminc/hapi-rate-limitor",
  "version": "4.0.2",
  "description": "Zero-dependency Redis-backed rate limiting for hapi that keeps your API up when Redis is not",
  "license": "MIT",
  "author": "Per Diem",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PerDiemInc/hapi-rate-limitor.git"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "lint": "biome check . && tsc --noEmit -p tsconfig.json",
    "pretest": "npm run build",
    "test": "node --test --experimental-test-coverage --test-coverage-include='dist/**' --test-coverage-lines=95 --test-concurrency=1 test/*.test.js",
    "prepublishOnly": "npm run build",
    "format": "biome check --write ."
  },
  "keywords": [
    "hapi",
    "hapi-plugin",
    "rate-limit",
    "rate-limiter",
    "redis",
    "valkey",
    "brute-force",
    "cloudfront"
  ],
  "peerDependencies": {
    "@hapi/hapi": "^21.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@hapi/hapi": "^21.4.12",
    "@types/node": "^26.6.5",
    "ioredis": "^6.0.0",
    "typescript": "^7.0.2"
  },
  "homepage": "https://github.com/PerDiemInc/hapi-rate-limitor#readme"
}
